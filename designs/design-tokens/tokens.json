{
  "name": "Chat UI Kit — Minimal & Clean",
  "description": "Single source of truth for the chat app design system. Mirrored in web/css/tokens.css and flutter/lib/theme/app_colors.dart — if you change a value, update it in all three places.",

  "color": {
    "light": {
      "paper":        "#FBFBFA",
      "surface":      "#FFFFFF",
      "surfaceSunken":"#F4F4F6",
      "ink":          "#1C1D21",
      "inkSecondary": "#6B6D76",
      "inkTertiary":  "#9C9EA7",
      "mist":         "#E7E7EA",
      "mistStrong":   "#D6D7DC",
      "cobalt":       "#3049B5",
      "cobaltHover":  "#28409A",
      "cobaltTint":   "#EAEDF9",
      "signalGreen":  "#35A26A",
      "coral":        "#E5484D",
      "coralTint":    "#FBEAEA",
      "amber":        "#B7791F"
    },
    "dark": {
      "paper":        "#111214",
      "surface":      "#1A1B1E",
      "surfaceSunken":"#0D0E10",
      "ink":          "#F2F2F3",
      "inkSecondary": "#A6A8B1",
      "inkTertiary":  "#71737C",
      "mist":         "#2A2B2F",
      "mistStrong":   "#3A3C42",
      "cobalt":       "#5A72E0",
      "cobaltHover":  "#6C82E8",
      "cobaltTint":   "#1E2440",
      "signalGreen":  "#41C384",
      "coral":        "#F27075",
      "coralTint":    "#3A1F21",
      "amber":        "#D6A03D"
    }
  },

  "typography": {
    "fontFamilyUI": "Inter, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "fontFamilyMono": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace",
    "note": "Mono face is reserved for timestamps, unread counts, and metadata only — the signature detail of this kit. Never use mono for message body text.",
    "scale": {
      "display":  { "size": 28, "weight": 600, "lineHeight": 34, "tracking": -0.3 },
      "title":    { "size": 20, "weight": 600, "lineHeight": 26, "tracking": -0.2 },
      "subtitle": { "size": 16, "weight": 600, "lineHeight": 22, "tracking": 0 },
      "body":     { "size": 15, "weight": 400, "lineHeight": 21, "tracking": 0 },
      "bodyStrong": { "size": 15, "weight": 500, "lineHeight": 21, "tracking": 0 },
      "caption":  { "size": 13, "weight": 400, "lineHeight": 18, "tracking": 0 },
      "mono":     { "size": 11, "weight": 500, "lineHeight": 14, "tracking": 0.2 }
    }
  },

  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "xxxl": 32, "huge": 48 },

  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pill": 999,
    "bubbleSent": "16px 16px 4px 16px",
    "bubbleReceived": "16px 16px 16px 4px",
    "note": "The 4px squared corner on the bubble's own-side is the signature detail — it replaces the usual speech-tail graphic."
  },

  "shadow": {
    "none": "none",
    "flat": "0 1px 0 rgba(28,29,33,0.04)",
    "raised": "0 8px 24px rgba(28,29,33,0.10)",
    "note": "Elevation is mostly conveyed with 1px hairline borders (mist), not drop shadows. 'raised' is reserved for modals/sheets only."
  },

  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "260ms",
    "easing": "cubic-bezier(0.2, 0.0, 0, 1)"
  }
}
